{
  "_not": "Tek kaynak. Elle tokens.css / theme.ts düzenleme; bu dosyayı değiştirip scripts/build_tokens.py çalıştır.",
  "color": {
    "brand": {
      "50": "#fdf4ee", "100": "#fbe6d8", "200": "#f6c9ad", "300": "#f0a77b", "400": "#eb8b55",
      "500": "#e6743b", "600": "#d35e26", "700": "#b94916", "800": "#933a16", "900": "#763217"
    },
    "slate": {
      "50": "#f8fafc", "100": "#f1f5f9", "200": "#e2e8f0", "300": "#cbd5e1", "400": "#94a3b8",
      "500": "#64748b", "600": "#475569", "700": "#334155", "800": "#1e293b", "900": "#0f172a"
    },
    "success": { "fg": "#15803d", "bg": "#f0fdf4", "border": "#bbf7d0", "solid": "#16a34a" },
    "danger":  { "fg": "#b91c1c", "bg": "#fef2f2", "border": "#fecaca", "solid": "#dc2626" },
    "warning": { "fg": "#a16207", "bg": "#fefce8", "border": "#fde68a", "solid": "#ca8a04" },
    "info":    { "fg": "#1d4ed8", "bg": "#eff6ff", "border": "#bfdbfe", "solid": "#2563eb" },
    "white": "#ffffff"
  },
  "semantic": {
    "bg": "{color.slate.100}",
    "surface": "{color.white}",
    "surface-muted": "{color.slate.50}",
    "border": "{color.slate.200}",
    "border-strong": "{color.slate.300}",
    "text": "{color.slate.900}",
    "text-muted": "{color.slate.600}",
    "text-subtle": "{color.slate.500}",
    "text-disabled": "{color.slate.400}",
    "primary": "{color.brand.500}",
    "primary-hover": "{color.brand.400}",
    "primary-active": "{color.brand.600}",
    "on-primary": "{color.slate.900}",
    "accent": "{color.brand.500}",
    "accent-soft": "{color.brand.50}",
    "link": "{color.brand.700}",
    "focus-ring": "{color.brand.500}",
    "overlay": "rgba(15, 23, 42, 0.6)"
  },
  "font": {
    "family": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "family-mono": "ui-monospace, 'Cascadia Mono', Consolas, monospace",
    "size": { "xs": 11, "sm": 12, "md": 13, "base": 14, "lg": 16, "xl": 18, "2xl": 22, "3xl": 28 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line-height": { "tight": 1.25, "normal": 1.5, "relaxed": 1.65 }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "pill": 9999 },
  "control-height": { "sm": 30, "md": 38, "lg": 44 },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "md": "0 4px 14px rgba(15, 23, 42, 0.08)",
    "lg": "0 20px 48px rgba(15, 23, 42, 0.22)"
  },
  "z": { "dropdown": 1000, "sticky": 1500, "drawer": 2000, "modal": 5000, "toast": 6000 },
  "motion": { "fast": 120, "base": 180, "slow": 280 },
  "breakpoint": { "md": 768 }
}
